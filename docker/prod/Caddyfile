# Prod Caddyfile — fully static site, no backend, no TLS termination here.
# Reuses the main app's own battle-tested CSP/HSTS header block
# (encrypted1on1/docker/prod/Caddyfile) with the app-specific parts
# stripped: no 'wasm-unsafe-eval' (no WebAssembly/crypto on this site at
# all — confirmed via a real grep of the built bundle, see the repo's
# CLAUDE.md), no /api or /health routing (nothing to route to — there's no
# backend process in this image).
{
	skip_install_trust
	# No TLS/auto_https, ever — this container always sits behind something
	# that terminates TLS (a reverse proxy, a PaaS's own edge), same
	# reasoning the main app's Caddyfile.reverse-proxy already established.
	auto_https off
}

# PORT is a real env var the container itself reads, not a Compose-level
# indirection — works identically under plain `docker run`, Compose,
# Kubernetes, or a PaaS that injects its own PORT. Falls back to 8080 if
# unset.
:{$PORT:8080} {
	root * /srv
	# Stock caddy:2-alpine ships gzip/zstd only, not brotli (confirmed via
	# `caddy list-modules` — no http.encoders.br) unlike the main app's
	# FrankenPHP-based image, which bundles brotli support.
	encode zstd gzip

	header {
		# script-src needs 'unsafe-inline', unlike the main app's own copy of
		# this policy this was cloned from — confirmed for real (a live
		# CSP-violation console error, not assumed) that SvelteKit's static
		# adapter always emits a small inline <script> at the end of <body>
		# to bootstrap hydration (imports the real JS chunks, calls
		# kit.start()), on every prerendered page, with no adapter-static
		# option to move it to an external file. It's also not practically
		# hash-pinnable here the way the main app's CSP work considered:
		# that script embeds a per-build app ID and this build's own chunk
		# filenames, so its hash changes on every rebuild, and this
		# Caddyfile has no build step of its own to keep a hash in sync.
		#
		# style-src needs 'unsafe-inline' too, for the same "framework
		# internal, no escape hatch" reason — confirmed for real (another
		# live CSP-violation console error): SvelteKit's own client runtime
		# (not our code — grepped the built bundle to confirm) creates a
		# visually-hidden `aria-live` region for screen-reader navigation
		# announcements via a literal `style="position: absolute; ..."`
		# attribute, unconditionally, on every client-routed SvelteKit app.
		# That string happens to be a fixed constant today (no per-build
		# content, unlike the script above), so a hash pin was considered,
		# but rejected: it would silently break on a future @sveltejs/kit
		# version bump with nothing in this repo's CI to catch it, for a
		# narrower win than the reasoning below already covers.
		#
		# Both relaxations are accepted for the same reason: this site is
		# genuinely different from the main app — no backend, no user
		# accounts, no user-generated content anywhere for an attacker to
		# inject through in the first place — unlike the crypto-handling
		# main app, where neither relaxation was correctly ever made.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self'; font-src 'self'; connect-src 'self'; object-src 'none'; frame-src 'none'; worker-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		X-Frame-Options "DENY"
		# Set unconditionally even though this Caddy never terminates TLS
		# itself — whatever fronts it relays response headers through to the
		# browser unmodified, and per RFC 6797 browsers ignore this header
		# entirely when received over plain HTTP, so there's no downside to
		# always sending it. Same reasoning as the main app's
		# Caddyfile.reverse-proxy.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}

	# Every route is routename/index.html (src/routes/+layout.ts sets
	# trailingSlash = 'always' for exactly this reason — see its own
	# comment for the real bug this fixes), so plain file_server's own
	# standard directory -> index.html resolution is enough: no rewrite
	# hack needed, and it's what already correctly served the bare "/"
	# from day one. A request missing the trailing slash (e.g. /ru) is
	# canonicalized by file_server itself (a 308 redirect to /ru/) rather
	# than served in place — necessary, not just tidy: each page's relative
	# asset paths (../_app/...) are computed assuming the page is actually
	# served at a URL ending in "/", so silently serving that same content
	# at a mismatched URL would 404 every asset on the page (confirmed as
	# a real production bug before this fix). No catch-all /index.html
	# fallback for anything else (that pattern is for SPA-style routing):
	# every real route is genuinely prerendered (adapter-static, strict
	# mode), so anything not matched here stays a real 404.
	file_server
}
